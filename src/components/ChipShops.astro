---
import { Icon as Iconify } from 'astro-icon'
import { Icon } from '@astrojs/starlight/components';

interface Props {
	shops: {
        name: string
        link: string
        region?: string
        official?: boolean
    }[]
}

const getFlagEmoji = (countryCode?: string) => {
    if(countryCode === undefined) return ""

    const codePoints = countryCode
        .toUpperCase()
        .split('')
        .map(char =>  127397 + char.charCodeAt(0));
    return String.fromCodePoint(...codePoints);
}

const shops = Astro.props.shops.map(shop => ({
    ...shop,
    flagEmoji: getFlagEmoji(shop.region),
    ariaLabel:
        [shop.name, shop.official ? "official OSMU vendor" : undefined, "Region: " + shop.region]
        .filter(l => l !== undefined)
        .join(" | ")
}))

---
<script>
    import { polyfillCountryFlagEmojis } from "country-flag-emoji-polyfill";
    polyfillCountryFlagEmojis();
</script>

<label for="show-shops" aria-label="Shops" class="chip-shops">
    <input type="checkbox" id="show-shops" class="peer" aria-hidden="true">
    <Iconify name="fluent:cart-16-filled" class="cart-icon"/>
    <span class="divider" aria-hidden="true"></span>
    <span class="chip-label">Shops</span>
    <Icon name='down-caret' class='caret'/>
    <ul class="shop-list">
        {shops.map(shop => (
            <li aria-label={shop.ariaLabel}>
                <a href={shop.link} target="_blank" rel="noopener">
                    { shop.flagEmoji }
                    { shop.name }
                    {
                        shop.official &&
                        <span class="official">official</span>
                    }
                </a>
            </li>
        ))}
    </ul>
</label>

<style>
    .chip-shops {
        display: grid;
        grid-template-columns: auto auto 1fr auto;
        align-items: center;
        padding: 0.25rem 0.75rem 0.25rem 0.5rem;
        border: 1px solid var(--osmu-border-strong);
        border-radius: var(--osmu-radius);
        background: var(--osmu-surface);
        color: var(--osmu-text-secondary);
        font-size: 0.8125rem;
        cursor: pointer;
        transition: color 0.2s var(--osmu-ease), border-color 0.2s var(--osmu-ease),
            background-color 0.2s var(--osmu-ease);
        /* The country-flag polyfill needs its font ahead of the stack. */
        font-family: "Twemoji Country Flags", var(--osmu-font-body);
    }

    .chip-shops:hover {
        color: var(--osmu-accent);
        border-color: var(--osmu-accent-muted);
        background: var(--osmu-surface-hover);
    }

    .peer {
        display: none;
    }

    .cart-icon {
        width: 1em;
    }

    .divider {
        align-self: stretch;
        width: 1px;
        margin: 0.125rem 0.375rem;
        background: var(--osmu-border-strong);
    }

    .chip-label {
        font-weight: 700;
    }

    .caret {
        margin-inline-start: 0.375rem;
        transition: transform 0.2s var(--osmu-ease);
    }

    .peer:checked ~ .caret {
        transform: rotate(180deg);
    }

    .shop-list {
        grid-column-start: 3;
        display: grid;
        max-width: 0;
        max-height: 0;
        overflow: hidden;
        list-style: none;
        margin: 0;
        padding: 0;
        transition: max-width 0.25s var(--osmu-ease), max-height 0.25s var(--osmu-ease);
    }

    .peer:checked ~ .shop-list {
        max-width: 100vw;
        max-height: 100vh;
        padding-top: 0.25rem;
    }

    .shop-list a {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding-block: 0.125rem;
        color: var(--osmu-text);
        text-decoration: none;
    }

    .shop-list a:hover {
        color: var(--osmu-accent);
    }

    .official {
        border-radius: var(--osmu-radius-full);
        background: var(--osmu-accent);
        color: var(--osmu-accent-contrast);
        font-size: 0.6875rem;
        font-weight: 700;
        padding-inline: 0.5rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .chip-shops, .caret, .shop-list { transition: none; }
    }
</style>
