---
import { Icon } from "@astrojs/starlight/components";

interface Props {
	icon: Parameters<typeof Icon>[0]["name"];
    href: string
    label: string
}

const props = Astro.props
---

<a href={ props.href } target="_blank" rel="noopener" class="chip">
    <Icon name={ props.icon }></Icon>
    <span class="divider" aria-hidden="true"></span>
    { props.label }
</a>

<style>
    .chip {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.75rem 0.25rem 0.5rem;
        border: 1px solid var(--osmu-border-strong);
        border-radius: var(--osmu-radius-full);
        background: var(--osmu-surface);
        color: var(--osmu-text-secondary);
        font-size: 0.8125rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s var(--osmu-ease), border-color 0.2s var(--osmu-ease),
            background-color 0.2s var(--osmu-ease);
    }

    .chip:hover {
        color: var(--osmu-accent);
        border-color: var(--osmu-accent-muted);
        background: var(--osmu-surface-hover);
    }

    .divider {
        align-self: stretch;
        width: 1px;
        margin-block: 0.125rem;
        background: var(--osmu-border-strong);
    }
</style>
